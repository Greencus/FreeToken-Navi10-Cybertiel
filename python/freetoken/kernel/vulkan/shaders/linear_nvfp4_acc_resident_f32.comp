#version 450
// ModelOpt NVFP4 resident matvec: Y[T,N] = X[T,K] @ W[N,K]^T.
// W is U8-packed E2M1 (2 values/byte, LOW nibble first — validated by
// generation: nibble-low yields Paris/Berlin). Packed payload is uploaded
// as a raw byte row-major tensor [N, K/2]; the shader re-interprets it as
// a uint32 stream (K/8 words per row).
// Scales are float8_e4m3fn, one per 16 inputs, stored as uint scales32
// [N, K/64] (4 scale bytes per word, low byte first). One fp32 global
// scale (weight_scale_2) arrives via push constants. Dequant:
//   w = E2M1(q) * E4M3(s) * gscale   (symmetric; no zero-point).
// E2M1 (16 codes) and E4M3 (256 codes) are decoded once per workgroup
// into shared-memory LUTs (GCN has no fast exp2 for masses of scalars).
// The stored input_scale only scales quantized activations and is
// correctly ignored on this fp32-activation path.
//
// K-tiled ACCUMULATE variant (task #12): same kernel, but lane 0 does
// Y[t*N+n] += partial[0] so sequential expert down calls accumulate into
// one resident buffer (cleared once per layer via vkCmdFillBuffer). (grid = (N, T))
// instead of one per 128-row block (grid = (N/128, T)). The old layout
// gave 4 workgroups for a 512x2048 expert matvec (~512 threads on a 2560-
// shader GPU => ~2% occupancy; 0.445 ms/call). Now 128 threads tile the
// K loop per row (K/8 words split across lanes), accumulate in shared
// memory, tree-reduce, and one lane writes Y[t*N+n]. N=512 => 512
// workgroups. Scalar fallback path for GPUs without cooperative-matrix
// support.
layout(local_size_x=128) in;
layout(std430,binding=0) readonly buffer QBuf { uint packed32[]; };
layout(std430,binding=1) readonly buffer SBuf { uint scales32[]; };
layout(std430,binding=2) readonly buffer XBuf { float X[]; };
layout(std430,binding=3) buffer YBuf { float Y[]; };
layout(push_constant) uniform P { uint T;uint N;uint K;uint wpr;uint ng32;float gscale;uint slot0; } p;
shared float e2m1_lut[16];
shared float e4m3_lut[256];
shared float partial[128];
float e2m1_dec(uint v){
uint s=v>>3u,e=(v>>1u)&3u,m=v&1u;
float a=(e==0u)?(float(m)*0.5):(exp2(float(e)-1.0)*(1.0+float(m)*0.5));
return (s==1u)?-a:a;
}
float e4m3_dec(uint b){
uint s=b>>7u,e=(b>>3u)&15u,m=b&7u;
if(e==0u){float a=exp2(-6.0)*float(m)/8.0;return (s==1u)?-a:a;}
if(e==15u&&m==7u)return 0.0;
float a=exp2(float(e)-7.0)*(1.0+float(m)/8.0);
return (s==1u)?-a:a;
}
void main(){
uint li=gl_LocalInvocationID.x;
for(uint i=li;i<16u;i+=128u)e2m1_lut[i]=e2m1_dec(i);
for(uint i=li;i<256u;i+=128u)e4m3_lut[i]=e4m3_dec(i);
barrier();
float gs=p.gscale;
uint n=gl_WorkGroupID.x,t=gl_WorkGroupID.y;
if(n>=p.N||t>=p.T)return;
uint wbase=(p.slot0+n)*p.wpr,srow=(p.slot0+n)*p.ng32;
uint kbase=t*p.K;
float acc=0.0;
// Split the row's K/8 words across the 128 lanes.
for(uint w=li;w<p.wpr;w+=128u){
uint wd=packed32[wbase+w];
for(uint i=0u;i<4u;++i){
uint kpos=(w<<3u)+(i<<1u)+kbase;
uint g=(w<<3u)>>4u;                 // scale group index for this word
uint sw=scales32[srow+(g>>2u)];
float s=e4m3_lut[(sw>>(8u*(g&3u)))&255u]*gs;
uint elo=wd&15u;     wd=wd>>4u;
uint ehi=wd&15u;     wd=wd>>4u;
acc=fma(X[kpos],s*e2m1_lut[elo],acc);
acc=fma(X[kpos+1u],s*e2m1_lut[ehi],acc);
}
}
partial[li]=acc;
barrier();
// Tree reduce (log2(128) = 7 steps) then lane 0 writes the row.
for(uint stride=64u;stride>0u;stride>>=1u){
if(li<stride)partial[li]+=partial[li+stride];
barrier();
}
if(li==0u)Y[t*p.N+n]+=partial[0];
}