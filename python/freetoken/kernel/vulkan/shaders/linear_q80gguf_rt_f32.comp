#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_shuffle : require
// Q8_0 GEMV over the GGUF file's OWN packed bytes (FTV_Q80_GGUF_VARIANT=
// rt): the reference byte-gather loop, but the 7-barrier tree reduce is
// replaced by one LDS barrier for the cross-wave level plus a register
// subgroupShuffleXor butterfly.  Bit-exact: the baseline tree pairs
// (tid, tid+64) first (that merge needs LDS - waves cannot shuffle across
// each other), then the remaining levels are exactly a 64-wide XOR
// butterfly, so lane 0 accumulates in the SAME addition order.  Wave 1
// exits after the LDS barrier; subgroup ops only need their own wave.
layout(local_size_x=128) in;
layout(std430,binding=0) readonly buffer QBuf { uint Q[]; };
layout(std430,binding=1) readonly buffer BBuf { uint16_t B[]; };
layout(std430,binding=2) readonly buffer XBuf { float X[]; };
layout(std430,binding=3) writeonly buffer YBuf { float Y[]; };
layout(push_constant) uniform P {
    uint T; uint N; uint K; uint use_bias; uint rowstride;
} p;
shared float sums[128];

float bf16(uint bits) { return uintBitsToFloat(bits << 16u); }

// Round f32 -> bf16, round-to-nearest-even (same as torch.bfloat16()).
float to_bf16(float v) {
  uint f = floatBitsToUint(v);
  f = f + 0x7FFFu + ((f >> 16u) & 1u);   // RNE: half-ulp bias + lsb
  return uintBitsToFloat(f & 0xFFFF0000u);
}

// little-endian byte at byte-offset bi (any alignment)
uint byte_at(uint bi) { return (Q[bi >> 2u] >> ((bi & 3u) * 8u)) & 0xFFu; }

void main() {
  uint n = gl_WorkGroupID.x, t = gl_WorkGroupID.y, tid = gl_LocalInvocationID.x;
  if (n >= p.N || t >= p.T) return;
  float acc = 0.0;
  uint wb = n * p.rowstride, xo = t * p.K;
  for (uint k = tid; k < p.K; k += 128u) {
    uint bb = wb + (k >> 5u) * 34u;             // block base, byte addrs
    uint dl = byte_at(bb), dh = byte_at(bb + 1u);
    float d = float(unpackHalf2x16(dl | (dh << 8u)).x);
    uint q8 = byte_at(bb + 2u + (k & 31u));
    int q = q8 >= 0x80u ? int(q8) - 256 : int(q8);  // sign-extend int8
    acc = fma(X[xo + k], to_bf16(float(q) * d), acc);
  }
  sums[tid] = acc;
  barrier();
  if (tid < 64u) {
    // level s=64: cross-wave merge, the only level shuffles cannot do
    acc = acc + sums[tid + 64u];
    // levels s=32..1: the baseline's remaining tree IS a 64-wide XOR
    // butterfly; shuffleXor reads the pre-step value, matching sums[t]+=...
    for (uint s = 32u; s > 0u; s >>= 1u)
      acc += subgroupShuffleXor(acc, s);
    if (tid == 0u)
      Y[t * p.N + n] = acc + (p.use_bias != 0u ? bf16(uint(B[n])) : 0.0);
  }
}
