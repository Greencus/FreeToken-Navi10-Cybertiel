#version 450
// Fused 8-expert Q4_K down accumulate (MUL_MAT_ID-style, arena).
// ONE dispatch replaces the 8 per-expert linear_q4k_acc_resident dispatches
// of a layer.  Grid = (N down rows, 1): each 128-lane workgroup computes ALL
// 8 routed experts' down dots for ONE output row and accumulates them into
// Y row n in canonical expert order j = 0..7.
//
// Why ONE workgroup per row instead of grid (N, 8)?  The old path ran 8
// sequential dispatches, so row n received 8 fp32 RMW adds in strict
// dispatch order ((0 + d0) + d1 ... + d7).  With one WG per (j, n) the 8
// WGs sharing a row would race and the add order would be nondeterministic.
// Here each lane keeps 8 private accumulators (one per expert), a single
// 8-array tree reduce yields d_j for all j, lane 0 sums them in j order into
// a register and applies ONE add: Y[n] = 0 + ((d0 + d1) + ... + d7),
// bit-identical to the sequential chain (Y is pre-filled with exact +0.0).
// Each d_j is the SAME row_dot as linear_q4k_acc_resident_f32 (same
// lane->word split, super-block indexing, k4_sm extraction, FMA order,
// butterfly), so every dot is bit-equal to the 8-dispatch path.  Only the X
// base moves per expert (j*silu_N, matching where the fused gateup8 wrote
// expert j's silu(gate)*up).
//
// Bindings:
//   0 = arena packed Q4_K down bytes (slot stride = rows_per_slot rows)
//   1 = X (silu-all fp32, expert j at [j*silu_N ..))
//   2 = Y (fp32 [N], RMW accumulated)
//   3 = Ids u32[8] (expert j -> slot index; slot 0 = 0x7FFFFFFF sentinel)
//   4 = Gs float[16] (acc scale at Gs[8 + j])
// Push: {T, N, K, wpr, ng32, rows_per_slot, rowstride, silu_N} (32 B).
layout(local_size_x=128) in;
layout(std430,binding=0) readonly buffer QBuf { uint Q[]; };
layout(std430,binding=1) readonly buffer XBuf { float X[]; };
layout(std430,binding=2) buffer YBuf { float Y[]; };
layout(std430,binding=3) readonly buffer IBuf { uint Ids[]; };
layout(std430,binding=4) readonly buffer GBuf { float Gs[]; };
layout(push_constant) uniform P {
    uint T; uint N; uint K; uint wpr; uint ng32;
    uint rows_per_slot; uint rowstride; uint silu_N;
} p;
shared float partial[8][128];

uint byte3(uint i, uint w0, uint w1, uint w2) {
    return i < 4u ? ((w0 >> (8u * (i & 3u))) & 255u)
         : i < 8u ? ((w1 >> (8u * (i & 3u))) & 255u)
                  : ((w2 >> (8u * (i & 3u))) & 255u);
}

void k4_sm(uint j, uint w0, uint w1, uint w2, out uint sc, out uint m) {
    uint qj = byte3(j, w0, w1, w2);
    uint qp = byte3(j + 4u, w0, w1, w2);
    if (j < 4u) {
        sc = qj & 63u;
        m = qp & 63u;
    } else {
        uint qm = byte3(j - 4u, w0, w1, w2);
        sc = (qp & 15u) | ((qm >> 6u) << 4u);
        m = (qp >> 4u) | ((qj >> 6u) << 4u);
    }
}

void main() {
    uint li = gl_LocalInvocationID.x;
    uint n = gl_WorkGroupID.x;
    if (n >= p.N) return;
    // Per-expert private accumulators: expert j's dot for row n, all 8 in
    // one lane so the final adds can be serialized deterministically.
    float v0 = 0.0, v1 = 0.0, v2 = 0.0, v3 = 0.0;
    float v4 = 0.0, v5 = 0.0, v6 = 0.0, v7 = 0.0;
    for (uint w = li; w < p.wpr; w += 128u) {
        uint sb = w >> 5u;              // super-block within the row
        uint inb = w & 31u;             // qs word within the super-block
        uint it = inb >> 3u;            // 64-weight step inside the block
        uint klo0 = sb * 256u + it * 64u + (inb & 7u) * 4u;
        // --- expert 0 ---
        {
            uint sbase = (Ids[0u] * p.rows_per_slot + n) * p.rowstride
                       + sb * p.ng32;
            vec2 dm = unpackHalf2x16(Q[sbase]);
            uint w0 = Q[sbase + 1u], w1 = Q[sbase + 2u], w2 = Q[sbase + 3u];
            uint sc0, m0, sc1, m1;
            k4_sm(it << 1u, w0, w1, w2, sc0, m0);
            k4_sm((it << 1u) + 1u, w0, w1, w2, sc1, m1);
            float gs = Gs[8u + 0u];
            float d1 = dm.x * float(sc0) * gs, f1 = dm.y * float(m0) * gs;
            float d2 = dm.x * float(sc1) * gs, f2 = dm.y * float(m1) * gs;
            uint klo = 0u * p.silu_N + klo0;
            uint khi = klo + 32u;
            uint wd = Q[sbase + p.ng32 - 32u + inb];
            for (uint i = 0u; i < 4u; ++i) {
                uint ql = wd & 15u; wd >>= 4u;
                uint qh = wd & 15u; wd >>= 4u;
                v0 = fma(X[klo + i], fma(d1, float(ql), -f1), v0);
                v0 = fma(X[khi + i], fma(d2, float(qh), -f2), v0);
            }
        }
        // --- expert 1 ---
        {
            uint sbase = (Ids[1u] * p.rows_per_slot + n) * p.rowstride
                       + sb * p.ng32;
            vec2 dm = unpackHalf2x16(Q[sbase]);
            uint w0 = Q[sbase + 1u], w1 = Q[sbase + 2u], w2 = Q[sbase + 3u];
            uint sc0, m0, sc1, m1;
            k4_sm(it << 1u, w0, w1, w2, sc0, m0);
            k4_sm((it << 1u) + 1u, w0, w1, w2, sc1, m1);
            float gs = Gs[8u + 1u];
            float d1 = dm.x * float(sc0) * gs, f1 = dm.y * float(m0) * gs;
            float d2 = dm.x * float(sc1) * gs, f2 = dm.y * float(m1) * gs;
            uint klo = 1u * p.silu_N + klo0;
            uint khi = klo + 32u;
            uint wd = Q[sbase + p.ng32 - 32u + inb];
            for (uint i = 0u; i < 4u; ++i) {
                uint ql = wd & 15u; wd >>= 4u;
                uint qh = wd & 15u; wd >>= 4u;
                v1 = fma(X[klo + i], fma(d1, float(ql), -f1), v1);
                v1 = fma(X[khi + i], fma(d2, float(qh), -f2), v1);
            }
        }
        // --- expert 2 ---
        {
            uint sbase = (Ids[2u] * p.rows_per_slot + n) * p.rowstride
                       + sb * p.ng32;
            vec2 dm = unpackHalf2x16(Q[sbase]);
            uint w0 = Q[sbase + 1u], w1 = Q[sbase + 2u], w2 = Q[sbase + 3u];
            uint sc0, m0, sc1, m1;
            k4_sm(it << 1u, w0, w1, w2, sc0, m0);
            k4_sm((it << 1u) + 1u, w0, w1, w2, sc1, m1);
            float gs = Gs[8u + 2u];
            float d1 = dm.x * float(sc0) * gs, f1 = dm.y * float(m0) * gs;
            float d2 = dm.x * float(sc1) * gs, f2 = dm.y * float(m1) * gs;
            uint klo = 2u * p.silu_N + klo0;
            uint khi = klo + 32u;
            uint wd = Q[sbase + p.ng32 - 32u + inb];
            for (uint i = 0u; i < 4u; ++i) {
                uint ql = wd & 15u; wd >>= 4u;
                uint qh = wd & 15u; wd >>= 4u;
                v2 = fma(X[klo + i], fma(d1, float(ql), -f1), v2);
                v2 = fma(X[khi + i], fma(d2, float(qh), -f2), v2);
            }
        }
        // --- expert 3 ---
        {
            uint sbase = (Ids[3u] * p.rows_per_slot + n) * p.rowstride
                       + sb * p.ng32;
            vec2 dm = unpackHalf2x16(Q[sbase]);
            uint w0 = Q[sbase + 1u], w1 = Q[sbase + 2u], w2 = Q[sbase + 3u];
            uint sc0, m0, sc1, m1;
            k4_sm(it << 1u, w0, w1, w2, sc0, m0);
            k4_sm((it << 1u) + 1u, w0, w1, w2, sc1, m1);
            float gs = Gs[8u + 3u];
            float d1 = dm.x * float(sc0) * gs, f1 = dm.y * float(m0) * gs;
            float d2 = dm.x * float(sc1) * gs, f2 = dm.y * float(m1) * gs;
            uint klo = 3u * p.silu_N + klo0;
            uint khi = klo + 32u;
            uint wd = Q[sbase + p.ng32 - 32u + inb];
            for (uint i = 0u; i < 4u; ++i) {
                uint ql = wd & 15u; wd >>= 4u;
                uint qh = wd & 15u; wd >>= 4u;
                v3 = fma(X[klo + i], fma(d1, float(ql), -f1), v3);
                v3 = fma(X[khi + i], fma(d2, float(qh), -f2), v3);
            }
        }
        // --- expert 4 ---
        {
            uint sbase = (Ids[4u] * p.rows_per_slot + n) * p.rowstride
                       + sb * p.ng32;
            vec2 dm = unpackHalf2x16(Q[sbase]);
            uint w0 = Q[sbase + 1u], w1 = Q[sbase + 2u], w2 = Q[sbase + 3u];
            uint sc0, m0, sc1, m1;
            k4_sm(it << 1u, w0, w1, w2, sc0, m0);
            k4_sm((it << 1u) + 1u, w0, w1, w2, sc1, m1);
            float gs = Gs[8u + 4u];
            float d1 = dm.x * float(sc0) * gs, f1 = dm.y * float(m0) * gs;
            float d2 = dm.x * float(sc1) * gs, f2 = dm.y * float(m1) * gs;
            uint klo = 4u * p.silu_N + klo0;
            uint khi = klo + 32u;
            uint wd = Q[sbase + p.ng32 - 32u + inb];
            for (uint i = 0u; i < 4u; ++i) {
                uint ql = wd & 15u; wd >>= 4u;
                uint qh = wd & 15u; wd >>= 4u;
                v4 = fma(X[klo + i], fma(d1, float(ql), -f1), v4);
                v4 = fma(X[khi + i], fma(d2, float(qh), -f2), v4);
            }
        }
        // --- expert 5 ---
        {
            uint sbase = (Ids[5u] * p.rows_per_slot + n) * p.rowstride
                       + sb * p.ng32;
            vec2 dm = unpackHalf2x16(Q[sbase]);
            uint w0 = Q[sbase + 1u], w1 = Q[sbase + 2u], w2 = Q[sbase + 3u];
            uint sc0, m0, sc1, m1;
            k4_sm(it << 1u, w0, w1, w2, sc0, m0);
            k4_sm((it << 1u) + 1u, w0, w1, w2, sc1, m1);
            float gs = Gs[8u + 5u];
            float d1 = dm.x * float(sc0) * gs, f1 = dm.y * float(m0) * gs;
            float d2 = dm.x * float(sc1) * gs, f2 = dm.y * float(m1) * gs;
            uint klo = 5u * p.silu_N + klo0;
            uint khi = klo + 32u;
            uint wd = Q[sbase + p.ng32 - 32u + inb];
            for (uint i = 0u; i < 4u; ++i) {
                uint ql = wd & 15u; wd >>= 4u;
                uint qh = wd & 15u; wd >>= 4u;
                v5 = fma(X[klo + i], fma(d1, float(ql), -f1), v5);
                v5 = fma(X[khi + i], fma(d2, float(qh), -f2), v5);
            }
        }
        // --- expert 6 ---
        {
            uint sbase = (Ids[6u] * p.rows_per_slot + n) * p.rowstride
                       + sb * p.ng32;
            vec2 dm = unpackHalf2x16(Q[sbase]);
            uint w0 = Q[sbase + 1u], w1 = Q[sbase + 2u], w2 = Q[sbase + 3u];
            uint sc0, m0, sc1, m1;
            k4_sm(it << 1u, w0, w1, w2, sc0, m0);
            k4_sm((it << 1u) + 1u, w0, w1, w2, sc1, m1);
            float gs = Gs[8u + 6u];
            float d1 = dm.x * float(sc0) * gs, f1 = dm.y * float(m0) * gs;
            float d2 = dm.x * float(sc1) * gs, f2 = dm.y * float(m1) * gs;
            uint klo = 6u * p.silu_N + klo0;
            uint khi = klo + 32u;
            uint wd = Q[sbase + p.ng32 - 32u + inb];
            for (uint i = 0u; i < 4u; ++i) {
                uint ql = wd & 15u; wd >>= 4u;
                uint qh = wd & 15u; wd >>= 4u;
                v6 = fma(X[klo + i], fma(d1, float(ql), -f1), v6);
                v6 = fma(X[khi + i], fma(d2, float(qh), -f2), v6);
            }
        }
        // --- expert 7 ---
        {
            uint sbase = (Ids[7u] * p.rows_per_slot + n) * p.rowstride
                       + sb * p.ng32;
            vec2 dm = unpackHalf2x16(Q[sbase]);
            uint w0 = Q[sbase + 1u], w1 = Q[sbase + 2u], w2 = Q[sbase + 3u];
            uint sc0, m0, sc1, m1;
            k4_sm(it << 1u, w0, w1, w2, sc0, m0);
            k4_sm((it << 1u) + 1u, w0, w1, w2, sc1, m1);
            float gs = Gs[8u + 7u];
            float d1 = dm.x * float(sc0) * gs, f1 = dm.y * float(m0) * gs;
            float d2 = dm.x * float(sc1) * gs, f2 = dm.y * float(m1) * gs;
            uint klo = 7u * p.silu_N + klo0;
            uint khi = klo + 32u;
            uint wd = Q[sbase + p.ng32 - 32u + inb];
            for (uint i = 0u; i < 4u; ++i) {
                uint ql = wd & 15u; wd >>= 4u;
                uint qh = wd & 15u; wd >>= 4u;
                v7 = fma(X[klo + i], fma(d1, float(ql), -f1), v7);
                v7 = fma(X[khi + i], fma(d2, float(qh), -f2), v7);
            }
        }
    }
    partial[0][li] = v0;
    partial[1][li] = v1;
    partial[2][li] = v2;
    partial[3][li] = v3;
    partial[4][li] = v4;
    partial[5][li] = v5;
    partial[6][li] = v6;
    partial[7][li] = v7;
    barrier();
    // Single butterfly reduce across all 8 arrays (same stride tree as the
    // per-expert kernel: partial[li] += partial[li+stride]).
    for (uint stride = 64u; stride > 0u; stride >>= 1u) {
        if (li < stride) {
            for (uint j = 0u; j < 8u; j++) partial[j][li] += partial[j][li + stride];
        }
        barrier();
    }
    if (li == 0u) {
        // Sequential fp32 adds in canonical expert order: bit-identical to
        // the old 8 sequential acc dispatches given the exact +0.0 fill.
        float r = 0.0;
        for (uint j = 0u; j < 8u; j++) r += partial[j][0];
        Y[n] += r;
    }
}
