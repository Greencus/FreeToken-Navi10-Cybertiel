#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// Q8_0 GEMV over the GGUF file's OWN packed bytes (FTV_DENSE_Q80): same
// workgroup/lane/reduce structure as linear_bf16_resident_f32, but the
// weight fetch decodes ggml block_q8_0 - 34 B per 32 values, byte 0 =
// fp16 scale d, bytes 2..33 = int8 codes, rows separated by exactly
// cols/32*34 bytes with no padding (K=512 rows land on 544 B, so every
// fetch is a dword load + byte shift from a pure byte address).
layout(local_size_x=128) in;
layout(std430,binding=0) readonly buffer QBuf { uint Q[]; };
layout(std430,binding=1) readonly buffer BBuf { uint16_t B[]; };
layout(std430,binding=2) readonly buffer XBuf { float X[]; };
layout(std430,binding=3) writeonly buffer YBuf { float Y[]; };
layout(push_constant) uniform P {
    uint T; uint N; uint K; uint use_bias; uint rowstride;
} p;
shared float sums[128];

float bf16(uint bits) { return uintBitsToFloat(bits << 16u); }

// Round f32 -> bf16, round-to-nearest-even (same as torch.bfloat16()).
// The default path stores each dequanted weight as bf16 and f32-accumulates
// those; rounding the Q8_0 decode the same way makes this shader's products
// BIT-IDENTICAL to linear_bf16_resident (the layer-parity gates compare
// against that host reference at 1e-5; unrounded they drift ~1e-3).
float to_bf16(float v) {
  uint f = floatBitsToUint(v);
  f = f + 0x7FFFu + ((f >> 16u) & 1u);   // RNE: half-ulp bias + lsb
  return uintBitsToFloat(f & 0xFFFF0000u);
}

// little-endian byte at byte-offset bi (any alignment)
uint byte_at(uint bi) { return (Q[bi >> 2u] >> ((bi & 3u) * 8u)) & 0xFFu; }

void main() {
  uint n = gl_WorkGroupID.x, t = gl_WorkGroupID.y, tid = gl_LocalInvocationID.x;
  if (n >= p.N || t >= p.T) return;
  float acc = 0.0;
  uint wb = n * p.rowstride, xo = t * p.K;
  for (uint k = tid; k < p.K; k += 128u) {
    uint bb = wb + (k >> 5u) * 34u;             // block base, byte addrs
    uint dl = byte_at(bb), dh = byte_at(bb + 1u);
    float d = float(unpackHalf2x16(dl | (dh << 8u)).x);
    uint q8 = byte_at(bb + 2u + (k & 31u));
    int q = q8 >= 0x80u ? int(q8) - 256 : int(q8);  // sign-extend int8
    acc = fma(X[xo + k], to_bf16(float(q) * d), acc);
  }
  sums[tid] = acc;
  barrier();
  for (uint s = 64u; s > 0u; s >>= 1u) {
    if (tid < s) sums[tid] += sums[tid + s];
    barrier();
  }
  if (tid == 0u)
    Y[t * p.N + n] = sums[0] + (p.use_bias != 0u ? bf16(uint(B[n])) : 0.0);
}
