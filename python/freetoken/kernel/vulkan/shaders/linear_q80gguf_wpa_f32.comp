#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_shuffle : require
// Q8_0 GEMV over the GGUF file's OWN packed bytes (FTV_Q80_GGUF_VARIANT=
// wpa): w64's two reference streams per 64-lane lane with the per-element
// address math strength-reduced BY HAND - a block start moves +136 bytes
// per 128-k step and 136 is 4-aligned, so the dword index, the dword
// shift nibble AND the in-block byte index are all loop-invariant: only a
// `+= 34` on two running dword pointers + `+= 128` on the X pointer
// remain.  Same values, same fma order -> bit-identical to ref; 0
// barriers.
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer QBuf { uint Q[]; };
layout(std430,binding=1) readonly buffer BBuf { uint16_t B[]; };
layout(std430,binding=2) readonly buffer XBuf { float X[]; };
layout(std430,binding=3) writeonly buffer YBuf { float Y[]; };
layout(push_constant) uniform P {
    uint T; uint N; uint K; uint use_bias; uint rowstride;
} p;

float bf16(uint bits) { return uintBitsToFloat(bits << 16u); }

// Round f32 -> bf16, round-to-nearest-even (same as torch.bfloat16()).
float to_bf16(float v) {
  uint f = floatBitsToUint(v);
  f = f + 0x7FFFu + ((f >> 16u) & 1u);   // RNE: half-ulp bias + lsb
  return uintBitsToFloat(f & 0xFFFF0000u);
}

// One reference stream's running state: dword indices for the block
// scale and the code byte, the loop-invariant dword shift amounts, the
// X pointer and the stream's current k.
struct Str { uint qd, cd, shd, shc, xp, k; };

void main() {
  uint n = gl_WorkGroupID.x, t = gl_WorkGroupID.y, tid = gl_LocalInvocationID.x;
  if (n >= p.N || t >= p.T) return;
  float accA = 0.0, accB = 0.0;
  uint wb = n * p.rowstride, xo = t * p.K;
  // stream A: k = tid + 128m; stream B: k = tid + 64 + 128m.
  // Within a stream k stays in the same 32-elem block slice phase:
  // block = (k0>>5) + 4m, in-block byte = k0 & 31 (both fixed).
  Str a, b;
  uint ba = wb + (tid >> 5) * 34u;
  uint ca = ba + 2u + (tid & 31u);
  a = Str(ba >> 2u, ca >> 2u, (ba & 3u) * 8u, (ca & 3u) * 8u, xo + tid, tid);
  uint kbb = tid + 64u;
  uint bb = wb + (kbb >> 5) * 34u;
  uint cb = bb + 2u + (kbb & 31u);
  b = Str(bb >> 2u, cb >> 2u, (bb & 3u) * 8u, (cb & 3u) * 8u, xo + kbb, kbb);
  for (uint m = 0u; (m << 7u) < p.K; ++m) {
    if (a.k < p.K) {
      uint wd = (Q[a.qd] >> a.shd) & 0xFFFFu;
      uint q8 = (Q[a.cd] >> a.shc) & 0xFFu;
      float d = float(unpackHalf2x16(wd).x);
      int q = q8 >= 0x80u ? int(q8) - 256 : int(q8);
      accA = fma(X[a.xp], to_bf16(float(q) * d), accA);
    }
    if (b.k < p.K) {
      uint wd = (Q[b.qd] >> b.shd) & 0xFFFFu;
      uint q8 = (Q[b.cd] >> b.shc) & 0xFFu;
      float d = float(unpackHalf2x16(wd).x);
      int q = q8 >= 0x80u ? int(q8) - 256 : int(q8);
      accB = fma(X[b.xp], to_bf16(float(q) * d), accB);
    }
    a.qd += 34u; a.cd += 34u; a.xp += 128u; a.k += 128u;
    b.qd += 34u; b.cd += 34u; b.xp += 128u; b.k += 128u;
  }
  // Baseline level s=64 (sums[t] += sums[t+64]) is stream A += stream B
  // in this lane; levels s=32..1 are the 64-wide XOR butterfly.
  float acc = accA + accB;
  for (uint s = 32u; s > 0u; s >>= 1u)
    acc += subgroupShuffleXor(acc, s);
  if (tid == 0u)
    Y[t * p.N + n] = acc + (p.use_bias != 0u ? bf16(uint(B[n])) : 0.0);
}
