#version 450
// ggml Q4_K fused gate+up with SiLU fold. For one expert with a PACKED
// stacked bundle (gate rows 0..N-1, up rows N..2N-1, same quant format),
// ONE kernel call computes
//   gate[n] = sum_k X[t,k] * Wg[n,k]
//   up[n]   = sum_k X[t,k] * Wu[n,k]
// and writes Y[t*N+n] = silu(gate[n]) * up[n] - the down projection's
// input - so the down matvec can read this buffer resident-to-resident
// with no host round trip between the two GEMVs.
//
// Packed layout, unpack math and work mapping are exactly
// linear_q4k_resident_f32.comp (see there); this variant only reads two
// packed rows per workgroup and folds silu at the end. Two parallel tree
// reductions through single-writer shared memory (gate + up).
layout(local_size_x=128) in;
layout(std430,binding=0) readonly buffer QBuf { uint Q[]; };
layout(std430,binding=1) readonly buffer XBuf { float X[]; };
layout(std430,binding=2) writeonly buffer YBuf { float Y[]; };
// N = gate rows; the up twin of row n sits at row n+N of the same bundle.
layout(push_constant) uniform P {
    uint T; uint N; uint K; uint wpr; uint ng32;
    float gscale;
    uint slot0; uint rowstride;
} p;
shared float partial[128];
shared float partial_u[128];

uint byte3(uint i, uint w0, uint w1, uint w2) {
    return i < 4u ? ((w0 >> (8u * (i & 3u))) & 255u)
         : i < 8u ? ((w1 >> (8u * (i & 3u))) & 255u)
                  : ((w2 >> (8u * (i & 3u))) & 255u);
}

void k4_sm(uint j, uint w0, uint w1, uint w2, out uint sc, out uint m) {
    uint qj = byte3(j, w0, w1, w2);
    uint qp = byte3(j + 4u, w0, w1, w2);
    if (j < 4u) {
        sc = qj & 63u;
        m = qp & 63u;
    } else {
        uint qm = byte3(j - 4u, w0, w1, w2);
        sc = (qp & 15u) | ((qm >> 6u) << 4u);
        m = (qp >> 4u) | ((qj >> 6u) << 4u);
    }
}

float row_dot(uint row, uint kbase, float gs) {
    uint li = gl_LocalInvocationID.x;
    uint wbase = row * p.rowstride;
    float acc = 0.0;
    for (uint w = li; w < p.wpr; w += 128u) {
        uint sb = w >> 5u;
        uint inb = w & 31u;
        uint sbase = wbase + sb * p.ng32;
        vec2 dm = unpackHalf2x16(Q[sbase]);
        uint w0 = Q[sbase + 1u], w1 = Q[sbase + 2u], w2 = Q[sbase + 3u];
        uint it = inb >> 3u;
        uint sc0, m0, sc1, m1;
        k4_sm(it << 1u, w0, w1, w2, sc0, m0);
        k4_sm((it << 1u) + 1u, w0, w1, w2, sc1, m1);
        float d1 = dm.x * float(sc0) * gs, f1 = dm.y * float(m0) * gs;
        float d2 = dm.x * float(sc1) * gs, f2 = dm.y * float(m1) * gs;
        uint klo = kbase + sb * 256u + it * 64u + (inb & 7u) * 4u;
        uint khi = klo + 32u;
        uint wd = Q[sbase + p.ng32 - 32u + inb];
        for (uint i = 0u; i < 4u; ++i) {
            uint ql = wd & 15u; wd >>= 4u;
            uint qh = wd & 15u; wd >>= 4u;
            acc = fma(X[klo + i], fma(d1, float(ql), -f1), acc);
            acc = fma(X[khi + i], fma(d2, float(qh), -f2), acc);
        }
    }
    return acc;
}

void main() {
    uint n = gl_WorkGroupID.x, t = gl_WorkGroupID.y;
    if (n >= p.N || t >= p.T) return;
    uint li = gl_LocalInvocationID.x;
    uint kbase = t * p.K;
    partial[li] = row_dot(p.slot0 + n, kbase, p.gscale);
    partial_u[li] = row_dot(p.slot0 + n + p.N, kbase, p.gscale);
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) {
        if (li < s) {
            partial[li] += partial[li + s];
            partial_u[li] += partial_u[li + s];
        }
        barrier();
    }
    if (li == 0u) {
        float s = partial[0];
        Y[t * p.N + n] = (s / (1.0 + exp(-s))) * partial_u[0];
    }
}
